{
  "name": "web-thuyet-trinh",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.autoshop.app",
    "productName": "AutoShop",
    "win": {
      "target": "nsis",
      "icon": "assetsicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "assetsicon.ico",
      "shortcutName": "AutoShop"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      ".env"
    ]
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.2.1"
  }
}